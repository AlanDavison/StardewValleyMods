{
    "$schema": "https://smapi.io/schemas/content-patcher.json",
    "Changes": [
        {
            "Action": "Load",
            "Priority": "Low",
            "Target": "Maps/{{FarmId}}",
            "FromFile": "assets/maps/Farm_ExJoja.tmx"
        },
        {
            "LogName": "Patching EJF farm data into Data/Locations.",
            "Action": "EditData",
            "Target": "Data/Locations",
            "Entries": {
                "{{FarmID}}": {
                    "DisplayName": "{{i18n:EJF.Farm.Name}}",
                    "CanPlantHere": true,
                    "FirstDayWeedMultiplier": 10,
                    "MinDailyForageSpawn": 2,
                    "MaxDailyForageSpawn": 6,
                    "ChanceForClay": 0.1,
                    "MusicIgnoredInRain": true,
                    "CanHaveGreenRainSpawns": true,
                    "ArtifactSpots": [
                    ],
                    "FishAreas": {
                        "Global": {
                            "CrabPotFishTypes": [
                                "freshwater"
                            ],
                            "CrabPotJunkChance": 0.2
                        },
                        "SecretFishySpot": {
                            "CrabPotJunkChance": 1.0,
                            "Position": {
                                "X": 32,
                                "Y": 2,
                                "Width": 4,
                                "Height": 4
                            }
                        }
                    }
                }
            }
        }
    ]
}
